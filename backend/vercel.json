{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "schedules": {
    "birthday-emails-daily": {
      "schedule": "0 9 * * *",
      "timezone": "America/Sao_Paulo",
      "jitter": 15,
      "path": "/api/v1/calendar/birthdays/send",
      "requestMethod": "POST"
    }
  }
}
